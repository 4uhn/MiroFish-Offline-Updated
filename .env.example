# =============================================================
# MiroFish-Offline Configuration
# =============================================================
# This fork runs entirely on local models — no cloud APIs needed.
# Copy this file to .env and adjust values for your setup.
# Test before simulating: python backend/scripts/test_llm_readiness.py
# =============================================================

# ===== LLM Provider =====
# "ollama" (local, free, ~15s/call) | "groq" (cloud, fast, ~1s/call)
LLM_PROVIDER=ollama

# ===== Ollama Configuration (when LLM_PROVIDER=ollama) =====
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=qwen3:8b

# ===== Groq Configuration (when LLM_PROVIDER=groq) =====
# Get a free API key at https://console.groq.com/keys
# GROQ_API_KEY=your_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# ===== Neo4j Configuration =====
# For Docker: use service name "neo4j" instead of "localhost"
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish123

# ===== Embedding Configuration =====
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434

# ===== OASIS / CAMEL-AI Configuration =====
OPENAI_API_KEY=ollama
OPENAI_API_BASE_URL=http://localhost:11434/v1

# ===== Simulation Tuning =====
OASIS_DEFAULT_MAX_ROUNDS=10
MAX_AGENT_ENTITIES=30
LLM_SEMAPHORE=5

# ===== Tiered Model Routing (optional) =====
# Fast model for extraction tasks (NER, classification). Speeds up graph building ~5x.
# Leave empty/commented to use the main model for everything.
# Requires: ollama pull qwen3:0.6b
# LLM_FAST_MODEL_NAME=qwen3:0.6b
# LLM_FAST_NUM_CTX=2048

# ===== Ollama Performance Tuning (only when LLM_PROVIDER=ollama) =====
OLLAMA_NUM_PARALLEL=3
OLLAMA_KEEP_ALIVE=-1
OLLAMA_NUM_CTX=2048
# KV cache quantization: q8_0 halves memory usage with negligible quality loss
OLLAMA_KV_CACHE_TYPE=q8_0

# ===== Docker-mode overrides =====
# Uncomment these when running ALL services inside Docker
# LLM_BASE_URL=http://ollama:11434/v1
# NEO4J_URI=bolt://neo4j:7687
# EMBEDDING_BASE_URL=http://ollama:11434
# OPENAI_API_BASE_URL=http://ollama:11434/v1
