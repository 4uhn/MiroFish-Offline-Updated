# =============================================================
# MiroFish-Offline+ configuration
# Copy to .env and adjust. Everything runs locally; no cloud APIs.
# =============================================================

# ===== LLM (Ollama, or any OpenAI-compatible server) =====
LLM_PROVIDER=ollama
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=qwen3:8b

# Context window the backend budgets for. Ollama's /v1 endpoint ignores a
# per-request num_ctx, so this must match the server's OLLAMA_CONTEXT_LENGTH
# (set when starting `ollama serve`, see README).
OLLAMA_NUM_CTX=8192

# ===== Neo4j =====
# Also used by docker-compose to set the Neo4j password. Pick your own.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# ===== Embeddings =====
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434

# ===== OASIS / CAMEL-AI (simulation subprocess) =====
OPENAI_API_KEY=ollama
OPENAI_API_BASE_URL=http://localhost:11434/v1

# ===== Simulation =====
OASIS_DEFAULT_MAX_ROUNDS=10
MAX_AGENT_ENTITIES=30          # graph entities + synthetic public agents
SIM_MAX_AGENTS_PER_HOUR=8      # agents activated per simulated hour
SIM_AGENT_HISTORY_TURNS=0      # past turns kept in each agent's prompt
SIM_FACTS_INSTITUTION=6        # graph facts injected per institutional agent
SIM_FACTS_INDIVIDUAL=4         # graph facts injected per individual agent
SIM_POOL_AMPLIFY_PROB=0.3      # chance an agent amplifies a same-voice post instead of writing
SIM_GEN_TEMPERATURE=0.9
SIM_GEN_TOP_P=0.95
SIM_MODEL_TIMEOUT=600
SIM_MODEL_MAX_RETRIES=1

# ===== Graph memory (simulation activity -> Neo4j) =====
GRAPH_MEMORY_DRAIN_TIMEOUT=1800  # seconds the report waits for pending activity
GRAPH_MEMORY_DRAIN_WORKERS=3     # match Ollama's parallel slots
NER_REQUEST_TIMEOUT=900
